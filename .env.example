# Copy only the variables you need into a private .env file. Never commit .env.
# Never store seed phrases, raw private keys, signed transactions, or credential-bearing URLs in Git.

# Dune Analytics
DUNE_API_KEY_FREE=
# DUNE_API_KEY_FREE_2=
# DUNE_API_KEY_PAID=

# Solscan Pro
SOLSCAN_API_KEY=

# Nansen
NANSEN_API_KEY=
# NANSEN_API_KEY_2=

# Solana RPC
# Prefer a private shell/secret manager for credential-bearing provider URLs.
SOLANA_RPC_URL=
# SOLANA_RPC_URL_ARCHIVE=
# SOLANA_RPC_URL_FALLBACK=

# Optional external signer/keypair-path interface for a separately reviewed workflow.
# Do not point this at a primary wallet; read-only skills do not need it.
# SOLANA_KEYPAIR_PATH=

# Optional provider credentials
# PUMPPORTAL_API_KEY=
# JITO_AUTH_UUID=
# BLOXROUTE_AUTH=

# CoinMarketCap
CMC_API_KEY=
# CMC_API_KEY_2=
